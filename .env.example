# ==============================================================
# OpenProject Title Validator Webhook Configuration
# ==============================================================
# Copy this file to .env and fill in your values.

# [REQUIRED] Base URL of your OpenProject instance
# Example: https://openproject.example.com or http://openproject:8080 (intra-container)
OPENPROJECT_URL=https://openproject.example.com

# [REQUIRED] OpenProject API Key
# Generate from: OpenProject → My Account → Access Token → API
OPENPROJECT_API_KEY=your-openproject-api-key-here

# [OPTIONAL] Webhook signature secret for verifying OpenProject requests
# Must match the secret configured in OpenProject webhook settings.
# WEBHOOK_SECRET=your-shared-secret-here

# [OPTIONAL] HTTP server port (default: 8080)
# PORT=8080

# [OPTIONAL] Custom Title Regex Validation Pattern
# Default matches [TC-NNN][FEATURE][SUB FEATURE][PIC TESTER] (at least 3-digit TC number)
# TITLE_PATTERN=^\[TC-\d{3,}\]\[[^\[\]]+\]\[[^\[\]]+\]\[[^\[\]]+\]$

# [OPTIONAL] Custom Title Criteria Description for Comments
# Default: [TC-NNN][NAMA FEATURE][SUB FEATURE][PIC TESTER]
# TITLE_CRITERIA_DESC=[TC-NNN][NAMA FEATURE][SUB FEATURE][PIC TESTER]

# [OPTIONAL] Custom Comment Template for Invalid Titles
# Supported placeholders: {author}, {criteria}, {violations}
# Default: @{author}, judul tiket ini tidak sesuai dengan kriteria **{criteria}**! Harap perbarui judul tiket ini!
# COMMENT_TEMPLATE=@{author}, judul tiket ini tidak sesuai dengan kriteria **{criteria}**! Harap perbarui judul tiket ini!
