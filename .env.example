# ==============================================================
# OpenProject Title Validator Webhook Configuration
# ==============================================================
# Copy this file to .env and fill in your values.

# [REQUIRED] Base URL of your OpenProject instance
# Example: https://openproject.example.com
OPENPROJECT_URL=https://openproject.example.com

# [REQUIRED] OpenProject API Key
# Generate from: OpenProject → My Account → Access Token → API
OPENPROJECT_API_KEY=your-openproject-api-key-here

# [OPTIONAL] Webhook signature secret for verifying OpenProject requests
# Must match the secret configured in OpenProject webhook settings.
# WEBHOOK_SECRET=your-shared-secret-here

# [OPTIONAL] HTTP server port (default: 8080)
# PORT=8080
